// Salão Marketing - Database Schema
// Plataforma de marketing digital para salão de beleza

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUÁRIOS ────────────────────────────────────────

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(ADMIN)
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  media          Media[]
  posts          Post[]
  socialAccounts SocialAccount[]
  clients        Client[]

  @@map("users")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// ─── MÍDIA ───────────────────────────────────────────

model Media {
  id             String      @id @default(cuid())
  userId         String
  filename       String
  originalName   String
  mimeType       String
  size           Int
  path           String
  thumbnailPath  String?
  type           MediaType
  width          Int?
  height         Int?
  duration       Float?      // duração em segundos para vídeos
  metadata       Json?       // EXIF, dimensões, etc.
  aiAnalysis     Json?       // resultado da análise do Gemini
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags           MediaTag[]
  postMedia      PostMedia[]

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("media")
}

enum MediaType {
  IMAGE
  VIDEO
}

model MediaTag {
  id        String      @id @default(cuid())
  mediaId   String
  tag       String
  category  TagCategory @default(AUTO)
  createdAt DateTime    @default(now())

  media     Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, tag])
  @@index([tag])
  @@map("media_tags")
}

enum TagCategory {
  SERVICE      // cabelo, unhas, estética
  PROFESSIONAL // nome do profissional
  AUTO         // gerado automaticamente pela IA
  MANUAL       // adicionado manualmente
}

// ─── POSTS ───────────────────────────────────────────

model Post {
  id              String      @id @default(cuid())
  userId          String
  caption         String?     @db.Text
  hashtags        String?
  cta             String?     // call to action
  status          PostStatus  @default(DRAFT)
  platform        Platform    @default(BOTH)
  postType        PostType    @default(FEED)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalIdIG    String?     // ID do post no Instagram
  externalIdFB    String?     // ID do post no Facebook
  metrics         Json?       // engajamento, alcance, etc.
  aiGenerated     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia       PostMedia[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("posts")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  BOTH
}

enum PostType {
  FEED
  STORY
  REEL
}

model PostMedia {
  id       String @id @default(cuid())
  postId   String
  mediaId  String
  order    Int    @default(0)

  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@map("post_media")
}

// ─── CONTAS DE REDES SOCIAIS ─────────────────────────

model SocialAccount {
  id              String    @id @default(cuid())
  userId          String
  platform        Platform
  accountId       String
  accessToken     String    @db.Text
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?
  pageName        String?
  pageId          String?
  profilePicUrl   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("social_accounts")
}

// ─── CLIENTES & ANIVERSÁRIOS ─────────────────────────

model Client {
  id                String    @id @default(cuid())
  userId            String
  name              String
  phone             String
  email             String?
  birthDay          Int       // 1 a 31
  birthMonth        Int       // 1 a 12
  birthYear         Int?      // Ex: 1992
  instagram         String?
  preferredServices String?   // Ex: "Corte, Mechas, Escova"
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([birthMonth, birthDay])
  @@map("clients")
}

